rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function facultyOrAdmin() {
      return signedIn() && (
        request.auth.token.role == 'admin' ||
        (request.auth.token.role == 'faculty' && request.auth.token.email_verified == true)
      );
    }

    match /equipment/{equipmentId} {
      allow get, list: if signedIn() && resource.data.active == true;
      allow create, update, delete: if false;
    }

    match /bookings/{bookingId} {
      allow get, list: if signedIn() &&
        (resource.data.studentUid == request.auth.uid || facultyOrAdmin());
      allow create, update, delete: if false;
    }

    match /reservationLocks/{lockId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
